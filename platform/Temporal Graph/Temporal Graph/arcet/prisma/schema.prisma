// =============================================================================
// BASE ENTITY
// =============================================================================

model Entity {
  id              String       @id @default(uuid())
  type            EntityType
  displayName     String
  canonicalName   String?
  slug            String       @unique
  description     String?
  status          EntityStatus @default(ACTIVE)
  visibility      Visibility   @default(CLIENT_PRIVATE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  archivedAt      DateTime?
  createdByUserId String?
  updatedByUserId String?
  metadata        Json?

  // 1:1 typed profiles (only one of these is populated per entity)
  personProfile       PersonProfile?
  organisationProfile OrganisationProfile?
  constituencyProfile ConstituencyProfile?
  candidateProfile    CandidateProfile?
  factionProfile      FactionProfile?
  issueProfile        IssueProfile?
  policyProfile       PolicyProfile?
  eventProfile        PoliticalEvent?
  riskProfile         Risk?

  // child / join collections
  evidenceLinks      EntityEvidence[]
  riskLinks          RiskLink[]
  eventParticipation EventParticipant[]
  complianceFlags    ComplianceFlag[]

  @@index([type])
  @@index([status])
  @@index([visibility])
  @@index([canonicalName])
  @@index([displayName])
}

// =============================================================================
// TYPED PROFILES
// =============================================================================

model PersonProfile {
  id                    String      @id @default(uuid())
  entityId              String      @unique
  entity                Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  firstName             String?
  lastName              String?
  honorific             String?
  roleTitle             String?
  personType            PersonType  @default(OTHER)
  // soft pointers -> Entity ids (resolved in service layer)
  primaryOrganisationId String?
  primaryConstituencyId String?
  primaryFactionId      String?
  publicBio             String?
  privateNotes          String?
  publicProfileUrl      String?
  email                 String?
  phone                 String?
  isPolitician          Boolean     @default(false)
  isCandidate           Boolean     @default(false)
  isStakeholder         Boolean     @default(false)
  isJournalist          Boolean     @default(false)
  isDonor               Boolean     @default(false)
  isAdviser             Boolean     @default(false)
  isLocalPartyFigure    Boolean     @default(false)
  riskLevel             InfluenceLevel @default(UNKNOWN)
  confidence            Confidence  @default(LOW)
  sourceSummary         String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([personType])
  @@index([primaryOrganisationId])
  @@index([primaryConstituencyId])
  @@index([primaryFactionId])
}

model OrganisationProfile {
  id                   String           @id @default(uuid())
  entityId             String           @unique
  entity               Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  organisationType     OrganisationType @default(OTHER)
  website              String?
  geography            String?
  // soft pointers -> Entity ids
  primaryConstituencyId String?
  parentOrganisationId  String?
  description          String?
  issueFocus           String[]
  politicalRelevance   InfluenceLevel   @default(UNKNOWN)
  riskLevel            InfluenceLevel   @default(UNKNOWN)
  confidence           Confidence       @default(LOW)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([organisationType])
  @@index([primaryConstituencyId])
  @@index([parentOrganisationId])
}

model ConstituencyProfile {
  id                            String             @id @default(uuid())
  entityId                      String             @unique
  entity                        Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name                          String
  region                        String?
  country                       String?
  // soft pointers -> Entity ids
  currentRepresentativeEntityId String?
  incumbentPartyEntityId        String?
  previousWinningPartyEntityId  String?
  targetStatus                  TargetStatus       @default(UNKNOWN)
  strategicPriority             StrategicPriority  @default(MEDIUM)
  localPartyStrength            Int?               // 1..5
  campaignReadiness             Int?               // 1..5
  stakeholderCoverageScore      Float?             // 0..100
  localIssueVolatility          Int?               // 1..5
  tacticalVotingRisk            Int?               // 1..5
  spoilerRisk                   Int?               // 1..5
  overallCompetitiveness        Float?             // 0..100
  notes                         String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  @@index([targetStatus])
  @@index([strategicPriority])
}

model CandidateProfile {
  id                          String          @id @default(uuid())
  entityId                    String          @unique
  entity                      Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  // soft pointers -> Entity ids
  personEntityId              String?
  currentTargetConstituencyId String?
  partyEntityId               String?
  candidateStatus             CandidateStatus @default(PROSPECTIVE)
  politicalExperienceScore    Float?          // 0..100
  localConnectionScore        Float?
  mediaReadinessScore         Float?
  stakeholderStrengthScore    Float?
  localAssociationSupportScore Float?
  factionAcceptabilityScore   Float?
  issueCredibilityScore       Float?
  campaignCapacityScore       Float?
  riskScore                   Float?
  developmentPotentialScore   Float?
  overallReadinessScore       Float?
  summary                     String?
  strengths                   String[]
  weaknesses                  String[]
  developmentNeeds            String[]
  vettingStatus               VettingStatus   @default(NOT_STARTED)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@index([candidateStatus])
  @@index([personEntityId])
  @@index([currentTargetConstituencyId])
  @@index([partyEntityId])
}

model FactionProfile {
  id                  String              @id @default(uuid())
  entityId            String              @unique
  entity              Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  factionType         FactionType         @default(UNKNOWN)
  influenceScore      Float?              // 0..100
  leadershipAlignment LeadershipAlignment @default(UNKNOWN)
  currentMood         FactionMood         @default(UNKNOWN)
  riskLevel           InfluenceLevel      @default(UNKNOWN)
  confidence          Confidence          @default(LOW)
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([factionType])
}

model IssueProfile {
  id                    String        @id @default(uuid())
  entityId              String        @unique
  entity                Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name                  String
  issueCategory         IssueCategory @default(OTHER)
  nationalRelevance     Int?          // 1..5
  localRelevance        Int?          // 1..5
  mediaSensitivity      Int?          // 1..5
  factionSensitivity    Int?          // 1..5
  complianceSensitivity Int?          // 1..5
  description           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([issueCategory])
}

model PolicyProfile {
  id                    String       @id @default(uuid())
  entityId              String       @unique
  entity                Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  title                 String
  policyText            String?
  summary               String?
  issueEntityIds        String[]     // soft pointers -> Entity ids of ISSUEs
  policyStatus          PolicyStatus @default(DRAFT)
  announcementDate      DateTime?
  ownerEntityId         String?      // soft pointer -> Entity id
  overallPoliticalRisk  Severity     @default(LOW)
  overallComplianceRisk Severity     @default(LOW)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([policyStatus])
  @@index([ownerEntityId])
}

// =============================================================================
// RELATIONSHIP GRAPH
// =============================================================================

model Relationship {
  id                        String                @id @default(uuid())
  // graph edge endpoints — indexed UUID columns, resolved in service layer
  sourceEntityId            String
  targetEntityId            String
  type                      RelationshipType
  direction                 RelationshipDirection @default(DIRECTED)
  strength                  Int                   @default(3) // 1..5
  attitude                  Attitude              @default(UNKNOWN)
  influenceLevel            InfluenceLevel        @default(UNKNOWN)
  confidence                Confidence            @default(LOW)
  visibility                Visibility            @default(CLIENT_PRIVATE)
  relationshipOwnerUserId   String?
  relationshipOwnerEntityId String?
  lastInteractionAt         DateTime?
  validFrom                 DateTime?
  validTo                   DateTime?
  isCurrent                 Boolean               @default(true)
  summary                   String?
  privateNotes              String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  createdByUserId           String?
  updatedByUserId           String?

  evidenceLinks RelationshipEvidence[]

  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([type])
  @@index([isCurrent])
  @@index([lastInteractionAt])
  @@index([sourceEntityId, type])
  @@index([targetEntityId, type])
}

model RelationshipEvidence {
  id             String        @id @default(uuid())
  relationshipId String
  relationship   Relationship  @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  evidenceId     String
  evidence       EvidenceSource @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evidenceRole   EvidenceRole  @default(SUPPORTS)
  createdAt      DateTime      @default(now())

  @@unique([relationshipId, evidenceId])
  @@index([evidenceId])
}

// =============================================================================
// EVIDENCE / SOURCES
// =============================================================================

model EvidenceSource {
  id                 String             @id @default(uuid())
  title              String
  sourceType         SourceType         @default(MANUAL_ENTRY)
  url                String?
  fileId             String?
  rawText            String?
  summary            String?
  sourceDate         DateTime?
  observedAt         DateTime?
  addedByUserId      String?
  reliability        Reliability        @default(UNKNOWN)
  visibility         Visibility         @default(CLIENT_PRIVATE)
  dataClassification DataClassification @default(CLIENT_PRIVATE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  entityLinks       EntityEvidence[]
  relationshipLinks RelationshipEvidence[]

  @@index([sourceType])
  @@index([dataClassification])
  @@index([reliability])
}

model EntityEvidence {
  id           String         @id @default(uuid())
  entityId     String
  entity       Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  evidenceId   String
  evidence     EvidenceSource @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evidenceRole EvidenceRole   @default(SUPPORTS)
  createdAt    DateTime       @default(now())

  @@unique([entityId, evidenceId])
  @@index([evidenceId])
}

// =============================================================================
// EVENTS (temporal layer)
// =============================================================================

model PoliticalEvent {
  id                  String     @id @default(uuid())
  entityId            String     @unique // event's own base Entity (type EVENT)
  entity              Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  eventType           EventType  @default(OTHER)
  title               String
  summary             String?
  occurredAt          DateTime
  location            String?
  constituencyEntityId String?   // soft pointer
  issueEntityId        String?   // soft pointer
  sourceEvidenceId     String?   // soft pointer -> EvidenceSource
  confidence           Confidence @default(LOW)
  visibility           Visibility @default(CLIENT_PRIVATE)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  participants EventParticipant[]

  @@index([eventType])
  @@index([occurredAt])
  @@index([constituencyEntityId])
  @@index([issueEntityId])
}

model EventParticipant {
  id              String          @id @default(uuid())
  eventId         String
  event           PoliticalEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entityId        String
  entity          Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  participantRole ParticipantRole @default(ATTENDEE)
  createdAt       DateTime        @default(now())

  @@unique([eventId, entityId, participantRole])
  @@index([entityId])
}

// =============================================================================
// RISK
// =============================================================================

model Risk {
  id           String     @id @default(uuid())
  entityId     String     @unique // risk's own base Entity (type RISK)
  entity       Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  riskType     RiskType
  title        String
  description  String?
  severity     Severity   @default(MEDIUM)
  likelihood   Likelihood @default(UNKNOWN)
  urgency      Urgency    @default(MEDIUM)
  status       RiskStatus @default(OPEN)
  confidence   Confidence @default(LOW)
  ownerUserId  String?
  sourceModule String?
  rationale    String?
  mitigation   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  links RiskLink[]

  @@index([riskType])
  @@index([status])
  @@index([severity])
  @@index([sourceModule])
}

model RiskLink {
  id        String       @id @default(uuid())
  riskId    String
  risk      Risk         @relation(fields: [riskId], references: [id], onDelete: Cascade)
  entityId  String
  entity    Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  role      RiskLinkRole @default(AFFECTED)
  createdAt DateTime     @default(now())

  @@unique([riskId, entityId, role])
  @@index([entityId])
}

// =============================================================================
// SCORE (generic, shared scoring infrastructure)
// =============================================================================

model Score {
  id              String     @id @default(uuid())
  subjectEntityId String     // indexed UUID column
  contextEntityId String?    // e.g. the constituency a candidate score is "for"
  scoreType       ScoreType
  value           Float
  scaleMin        Float      @default(0)
  scaleMax        Float      @default(100)
  confidence      Confidence @default(LOW)
  sourceModule    String?
  modelVersion    String?
  rationale       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([subjectEntityId])
  @@index([contextEntityId])
  @@index([scoreType])
  @@index([subjectEntityId, scoreType])
  @@index([subjectEntityId, contextEntityId, scoreType])
}

// =============================================================================
// CANDIDATE-SEAT ASSESSMENT (bridge between candidate selection and FPTP)
// =============================================================================

model CandidateSeatAssessment {
  id                          String   @id @default(uuid())
  candidateEntityId           String
  constituencyEntityId        String
  assessmentDate              DateTime @default(now())
  overallFitScore             Float?
  readinessScore              Float?
  localConnectionScore        Float?
  stakeholderCoverageScore    Float?
  localAssociationSupportScore Float?
  factionAcceptabilityScore   Float?
  mediaReadinessScore         Float?
  issueCredibilityScore       Float?
  riskScore                   Float?
  developmentPotentialScore   Float?
  summary                     String?
  topStrengths                String[]
  topWeaknesses               String[]
  recommendedActions          String[]
  evidenceSummary             String?
  confidence                  Confidence @default(LOW)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([candidateEntityId])
  @@index([constituencyEntityId])
  @@index([candidateEntityId, constituencyEntityId])
}

// =============================================================================
// FPTP DATA STRUCTURES (consumed/written by the FPTP module — not computed here)
// =============================================================================

model ElectionResult {
  id                   String   @id @default(uuid())
  constituencyEntityId String
  electionDate         DateTime
  partyEntityId        String?
  candidateEntityId    String?
  votes                Int
  voteShare            Float    // 0..100
  position             Int
  turnout              Float?   // 0..100
  sourceEvidenceId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([constituencyEntityId])
  @@index([electionDate])
  @@index([constituencyEntityId, electionDate])
}

model FPTPScenario {
  id                       String                  @id @default(uuid())
  constituencyEntityId     String
  candidateEntityId        String?
  scenarioType             FPTPScenarioType
  title                    String
  assumptions              Json?
  estimatedWinProbability  Float?                  // 0..1
  estimatedVoteShareLow    Float?                  // 0..100
  estimatedVoteShareMid    Float?
  estimatedVoteShareHigh   Float?
  strategicValueScore      Float?                  // 0..100
  resourceWasteRisk        Float?                  // 0..100
  spoilerRisk              Float?
  tacticalVotingRisk       Float?
  localPartyImpact         String?
  stakeholderImpact        String?
  candidateDevelopmentValue Float?
  futureElectionValue      Float?
  recommendationLabel      FPTPRecommendationLabel?
  rationale                String?
  confidence               Confidence              @default(LOW)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([constituencyEntityId])
  @@index([candidateEntityId])
  @@index([scenarioType])
}

// =============================================================================
// POLICY RADIUS
// =============================================================================

model PolicyImpact {
  id                  String          @id @default(uuid())
  policyEntityId      String
  affectedEntityId    String
  impactType          PolicyImpactType
  impactDirection     ImpactDirection @default(UNKNOWN)
  severity            Severity        @default(MEDIUM)
  confidence          Confidence      @default(LOW)
  rationale           String?
  recommendedActionId String?         // soft pointer -> ActionRecommendation
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([policyEntityId])
  @@index([affectedEntityId])
  @@index([impactType])
}

// =============================================================================
// ACTION RECOMMENDATION
// =============================================================================

model ActionRecommendation {
  id                    String              @id @default(uuid())
  title                 String
  description           String?
  actionType            ActionType
  priority              ActionPriority      @default(MEDIUM)
  status                ActionStatus        @default(RECOMMENDED)
  targetEntityId        String?
  ownerUserId           String?
  ownerEntityId         String?
  dueDate               DateTime?
  sourceModule          String?
  rationale             String?
  expectedBenefit       String?
  downsideIfIgnored     String?
  approvalRequirement   ApprovalRequirement @default(NONE)
  relatedRiskId         String?
  relatedScenarioId     String?
  relatedPolicyImpactId String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  completedAt           DateTime?

  @@index([status])
  @@index([priority])
  @@index([targetEntityId])
  @@index([sourceModule])
  @@index([dueDate])
}

// =============================================================================
// COMPLIANCE + AUDIT
// =============================================================================

model ComplianceFlag {
  id              String               @id @default(uuid())
  entityId        String
  entity          Entity               @relation(fields: [entityId], references: [id], onDelete: Cascade)
  flagType        ComplianceFlagType
  severity        Severity             @default(MEDIUM)
  description     String?
  status          ComplianceFlagStatus @default(OPEN)
  reviewOwnerUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([entityId])
  @@index([flagType])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityId    String?
  objectType  String
  objectId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  @@index([entityId])
  @@index([objectType, objectId])
  @@index([actorUserId])
  @@index([createdAt])
}

// =============================================================================
// TEMPORAL GRAPH (time-aware layer over the ontology — see temporal MVP brief)
// -----------------------------------------------------------------------------
// All cross-references to ontology objects are soft pointers (indexed UUID
// columns resolved in the service layer), consistent with the ontology's own
// convention. Formal relations are used only between TemporalEvent and its
// child TemporalEventEntity rows. No new back-relations are added to Entity.
// =============================================================================

enum TemporalEventType {
  MEETING_OCCURRED
  CALL_OCCURRED
  EMAIL_RECEIVED
  EMAIL_SENT
  PUBLIC_STATEMENT_MADE
  POLICY_ANNOUNCED
  POLICY_DRAFTED
  CANDIDATE_SELECTED
  CANDIDATE_WITHDRAWN
  STAKEHOLDER_BRIEFED
  RELATIONSHIP_UPDATED
  RELATIONSHIP_DECAYED
  COMMITMENT_CREATED
  COMMITMENT_COMPLETED
  COMMITMENT_OVERDUE
  RISK_CREATED
  RISK_ESCALATED
  RISK_DEESCALATED
  RISK_RESOLVED
  SCORE_UPDATED
  ACTION_RECOMMENDED
  ACTION_ASSIGNED
  ACTION_COMPLETED
  FACTION_MOOD_CHANGED
  ISSUE_MOMENTUM_CHANGED
  FPTP_SCENARIO_CREATED
  FPTP_RECOMMENDATION_CHANGED
  POLICY_IMPACT_CREATED
  COMPLIANCE_FLAG_CREATED
  COMPLIANCE_FLAG_RESOLVED
  EVIDENCE_ADDED
  PROFILE_UPDATED
  OTHER
}

enum TemporalEntityRole {
  PRIMARY_SUBJECT
  SECONDARY_SUBJECT
  ACTOR
  TARGET
  AFFECTED
  MENTIONED
  OWNER
  SOURCE
  CONSTITUENCY_CONTEXT
  ISSUE_CONTEXT
  FACTION_CONTEXT
  POLICY_CONTEXT
  CANDIDATE_CONTEXT
  RELATIONSHIP_CONTEXT
}

enum ObservationType {
  RELATIONSHIP_STRENGTH
  RELATIONSHIP_ATTITUDE
  RELATIONSHIP_INFLUENCE
  RELATIONSHIP_DECAY
  STAKEHOLDER_ATTITUDE
  CANDIDATE_READINESS
  CANDIDATE_SEAT_FIT
  LOCAL_CONNECTION
  MEDIA_READINESS
  STAKEHOLDER_COVERAGE
  LOCAL_ASSOCIATION_SUPPORT
  FACTION_ACCEPTABILITY
  ISSUE_CREDIBILITY
  CANDIDATE_RISK
  CONSTITUENCY_COMPETITIVENESS
  LOCAL_PARTY_STRENGTH
  CAMPAIGN_READINESS
  TACTICAL_VOTING_RISK
  SPOILER_RISK
  ISSUE_MOMENTUM
  ISSUE_SALIENCE
  FACTION_MOOD
  FACTION_INFLUENCE
  FACTION_RISK
  POLICY_BLAST_RADIUS
  POLICY_STAKEHOLDER_RISK
  POLICY_FACTION_RISK
  POLICY_MEDIA_RISK
  POLICY_COMPLIANCE_RISK
  FPTP_WIN_PROBABILITY
  FPTP_STRATEGIC_VALUE
  ACTION_PRIORITY
  COMPLIANCE_RISK
  OTHER
}

enum ChangeType {
  CREATED
  UPDATED
  ARCHIVED
  DELETED
  SCORE_INCREASED
  SCORE_DECREASED
  RISK_ESCALATED
  RISK_DEESCALATED
  STATUS_CHANGED
  RELATIONSHIP_STRENGTHENED
  RELATIONSHIP_WEAKENED
  RELATIONSHIP_STALE
  ATTITUDE_IMPROVED
  ATTITUDE_WORSENED
  CANDIDATE_IMPROVED
  CANDIDATE_DETERIORATED
  CONSTITUENCY_BECAME_MORE_COMPETITIVE
  CONSTITUENCY_BECAME_LESS_COMPETITIVE
  FACTION_BECAME_MORE_HOSTILE
  FACTION_BECAME_LESS_HOSTILE
  ISSUE_GAINED_MOMENTUM
  ISSUE_LOST_MOMENTUM
  FPTP_RECOMMENDATION_CHANGED
  POLICY_RADIUS_EXPANDED
  POLICY_RADIUS_REDUCED
  COMPLIANCE_FLAG_ADDED
  COMPLIANCE_FLAG_RESOLVED
  OTHER
}

enum SnapshotType {
  ENTITY_PROFILE
  PERSON_CONTEXT
  CANDIDATE_CONTEXT
  CONSTITUENCY_CONTEXT
  RELATIONSHIP_CONTEXT
  ISSUE_CONTEXT
  FACTION_CONTEXT
  POLICY_CONTEXT
  WAR_ROOM_CONTEXT
  FPTP_CONTEXT
  CANDIDATE_SELECTION_CONTEXT
  POLICY_RADIUS_CONTEXT
  COMPLIANCE_CONTEXT
  OTHER
}

enum CommitmentType {
  FOLLOW_UP
  MEETING
  INTRODUCTION
  POLICY_CONSIDERATION
  EVENT_ATTENDANCE
  ENDORSEMENT
  SUPPORT_REQUEST
  INFORMATION_REQUEST
  LOCAL_ACTION
  DONOR_RELATED
  CANDIDATE_SELECTION_RELATED
  OTHER
}

enum CommitmentStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  BROKEN
  CANCELLED
  DISPUTED
}

enum Sensitivity {
  NORMAL
  SENSITIVE
  HIGHLY_SENSITIVE
  COMPLIANCE_REVIEW_REQUIRED
}

enum TimelineItemType {
  EVENT
  OBSERVATION
  CHANGE
  RISK
  ACTION
  COMMITMENT
  SCORE
  SCENARIO
  POLICY_IMPACT
  COMPLIANCE_FLAG
  NOTE
}

model TemporalEvent {
  id                 String             @id @default(uuid())
  politicalEventId   String? // soft pointer -> PoliticalEvent
  eventType          TemporalEventType  @default(OTHER)
  occurredAt         DateTime
  recordedAt         DateTime           @default(now())
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  title              String
  summary            String?
  sourceModule       String?
  createdByUserId    String?
  confidence         Confidence         @default(LOW)
  visibility         Visibility         @default(CLIENT_PRIVATE)
  dataClassification DataClassification @default(CLIENT_PRIVATE)
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  entities TemporalEventEntity[]

  @@index([eventType])
  @@index([occurredAt])
  @@index([recordedAt])
  @@index([politicalEventId])
}

model TemporalEventEntity {
  id              String             @id @default(uuid())
  temporalEventId String
  temporalEvent   TemporalEvent      @relation(fields: [temporalEventId], references: [id], onDelete: Cascade)
  entityId        String // soft pointer -> Entity
  role            TemporalEntityRole @default(PRIMARY_SUBJECT)
  createdAt       DateTime           @default(now())

  @@unique([temporalEventId, entityId, role])
  @@index([entityId])
}

model TemporalObservation {
  id                     String          @id @default(uuid())
  subjectEntityId        String
  contextEntityId        String?
  relationshipId         String?
  riskId                 String?
  scoreId                String?
  actionRecommendationId String?
  observationType        ObservationType
  observedAt             DateTime
  validFrom              DateTime?
  validTo                DateTime?
  valueNumeric           Float?
  valueText              String?
  valueJson              Json?
  confidence             Confidence      @default(LOW)
  sourceModule           String?
  sourceEvidenceId       String?
  sourceTemporalEventId  String?
  createdByUserId        String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([subjectEntityId])
  @@index([subjectEntityId, observationType])
  @@index([subjectEntityId, observationType, observedAt])
  @@index([contextEntityId])
  @@index([relationshipId])
  @@index([observedAt])
}

model TemporalChange {
  id                        String     @id @default(uuid())
  entityId                  String?
  relationshipId            String?
  riskId                    String?
  scoreId                   String?
  actionRecommendationId    String?
  candidateSeatAssessmentId String?
  fptpScenarioId            String?
  policyImpactId            String?
  changeType                ChangeType
  fieldName                 String?
  oldValue                  Json?
  newValue                  Json?
  deltaNumeric              Float?
  changedAt                 DateTime   @default(now())
  effectiveAt               DateTime?
  sourceModule              String?
  sourceTemporalEventId     String?
  sourceEvidenceId          String?
  changedByUserId           String?
  rationale                 String?
  confidence                Confidence @default(LOW)
  significant               Boolean    @default(false)
  createdAt                 DateTime   @default(now())

  @@index([entityId])
  @@index([changeType])
  @@index([changedAt])
  @@index([significant])
  @@index([fptpScenarioId])
  @@index([relationshipId])
}

model EntitySnapshot {
  id              String       @id @default(uuid())
  entityId        String
  snapshotType    SnapshotType
  snapshotAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  sourceModule    String?
  modelVersion    String?
  snapshotJson    Json
  summary         String?
  createdByUserId String?

  @@index([entityId])
  @@index([entityId, snapshotType])
  @@index([snapshotAt])
}

model RelationshipTemporalState {
  id                    String          @id @default(uuid())
  relationshipId        String
  observedAt            DateTime        @default(now())
  validFrom             DateTime?
  validTo               DateTime?
  strength              Int?
  attitude              Attitude?
  influenceLevel        InfluenceLevel?
  trustLevel            Int?
  stalenessScore        Float?
  decayScore            Float?
  lastInteractionAt     DateTime?
  openCommitmentCount   Int             @default(0)
  hostilitySignalCount  Int             @default(0)
  positiveSignalCount   Int             @default(0)
  confidence            Confidence      @default(LOW)
  rationale             String?
  sourceTemporalEventId String?
  createdAt             DateTime        @default(now())

  @@index([relationshipId])
  @@index([relationshipId, observedAt])
  @@index([stalenessScore])
}

model Commitment {
  id                          String           @id @default(uuid())
  fromEntityId                String
  toEntityId                  String?
  relatedIssueEntityId        String?
  relatedConstituencyEntityId String?
  relatedPolicyEntityId       String?
  relatedCandidateEntityId    String?
  title                       String
  description                 String?
  commitmentType              CommitmentType   @default(OTHER)
  status                      CommitmentStatus @default(OPEN)
  createdFromEventId          String?
  createdFromEvidenceId       String?
  promisedAt                  DateTime?
  dueAt                       DateTime?
  completedAt                 DateTime?
  sensitivity                 Sensitivity      @default(NORMAL)
  visibility                  Visibility       @default(CLIENT_PRIVATE)
  confidence                  Confidence       @default(LOW)
  ownerUserId                 String?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([status])
  @@index([dueAt])
  @@index([relatedCandidateEntityId])
  @@index([relatedConstituencyEntityId])
}

model TimelineItem {
  id               String           @id @default(uuid())
  entityId         String
  itemType         TimelineItemType
  itemAt           DateTime
  title            String
  summary          String?
  sourceObjectType String?
  sourceObjectId   String?
  severity         Severity?
  confidence       Confidence       @default(LOW)
  visibility       Visibility       @default(CLIENT_PRIVATE)
  createdAt        DateTime         @default(now())

  @@index([entityId])
  @@index([entityId, itemAt])
  @@index([itemType])
}
