// =============================================================================
// BASE ENTITY
// =============================================================================

model Entity {
  id              String       @id @default(uuid())
  type            EntityType
  displayName     String
  canonicalName   String?
  slug            String       @unique
  description     String?
  status          EntityStatus @default(ACTIVE)
  visibility      Visibility   @default(CLIENT_PRIVATE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  archivedAt      DateTime?
  createdByUserId String?
  updatedByUserId String?
  metadata        Json?

  // 1:1 typed profiles (only one of these is populated per entity)
  personProfile       PersonProfile?
  organisationProfile OrganisationProfile?
  constituencyProfile ConstituencyProfile?
  candidateProfile    CandidateProfile?
  factionProfile      FactionProfile?
  issueProfile        IssueProfile?
  policyProfile       PolicyProfile?
  eventProfile        PoliticalEvent?
  riskProfile         Risk?

  // child / join collections
  evidenceLinks      EntityEvidence[]
  riskLinks          RiskLink[]
  eventParticipation EventParticipant[]
  complianceFlags    ComplianceFlag[]

  @@index([type])
  @@index([status])
  @@index([visibility])
  @@index([canonicalName])
  @@index([displayName])
}

// =============================================================================
// TYPED PROFILES
// =============================================================================

model PersonProfile {
  id                    String      @id @default(uuid())
  entityId              String      @unique
  entity                Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  firstName             String?
  lastName              String?
  honorific             String?
  roleTitle             String?
  personType            PersonType  @default(OTHER)
  // soft pointers -> Entity ids (resolved in service layer)
  primaryOrganisationId String?
  primaryConstituencyId String?
  primaryFactionId      String?
  publicBio             String?
  privateNotes          String?
  publicProfileUrl      String?
  email                 String?
  phone                 String?
  isPolitician          Boolean     @default(false)
  isCandidate           Boolean     @default(false)
  isStakeholder         Boolean     @default(false)
  isJournalist          Boolean     @default(false)
  isDonor               Boolean     @default(false)
  isAdviser             Boolean     @default(false)
  isLocalPartyFigure    Boolean     @default(false)
  riskLevel             InfluenceLevel @default(UNKNOWN)
  confidence            Confidence  @default(LOW)
  sourceSummary         String?
  // transferability: which polity this actor belongs to, and which register resolved it
  jurisdiction          String?     @default("UK") // ISO country / polity code; lets models trained on UK transfer by jurisdiction
  sourceRegister        String?     // resolving register, e.g. "UK_PARLIAMENT", "UK_EC", "US_FEC"
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([personType])
  @@index([primaryOrganisationId])
  @@index([primaryConstituencyId])
  @@index([primaryFactionId])
  @@index([jurisdiction])
}

model OrganisationProfile {
  id                   String           @id @default(uuid())
  entityId             String           @unique
  entity               Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  organisationType     OrganisationType @default(OTHER)
  website              String?
  geography            String?
  // soft pointers -> Entity ids
  primaryConstituencyId String?
  parentOrganisationId  String?
  description          String?
  issueFocus           String[]
  politicalRelevance   InfluenceLevel   @default(UNKNOWN)
  riskLevel            InfluenceLevel   @default(UNKNOWN)
  confidence           Confidence       @default(LOW)
  // transferability: which polity this actor belongs to, and which register resolved it
  jurisdiction         String?          @default("UK") // ISO country / polity code; lets models trained on UK transfer by jurisdiction
  sourceRegister       String?          // resolving register, e.g. "UK_EC", "UK_COMPANIES_HOUSE", "UK_ORCL", "US_FEC"
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([organisationType])
  @@index([primaryConstituencyId])
  @@index([parentOrganisationId])
  @@index([jurisdiction])
}

model ConstituencyProfile {
  id                            String             @id @default(uuid())
  entityId                      String             @unique
  entity                        Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name                          String
  region                        String?
  country                       String?
  // soft pointers -> Entity ids
  currentRepresentativeEntityId String?
  incumbentPartyEntityId        String?
  previousWinningPartyEntityId  String?
  targetStatus                  TargetStatus       @default(UNKNOWN)
  strategicPriority             StrategicPriority  @default(MEDIUM)
  localPartyStrength            Int?               // 1..5
  campaignReadiness             Int?               // 1..5
  stakeholderCoverageScore      Float?             // 0..100
  localIssueVolatility          Int?               // 1..5
  tacticalVotingRisk            Int?               // 1..5
  spoilerRisk                   Int?               // 1..5
  overallCompetitiveness        Float?             // 0..100
  notes                         String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  @@index([targetStatus])
  @@index([strategicPriority])
}

model CandidateProfile {
  id                          String          @id @default(uuid())
  entityId                    String          @unique
  entity                      Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  // soft pointers -> Entity ids
  personEntityId              String?
  currentTargetConstituencyId String?
  partyEntityId               String?
  candidateStatus             CandidateStatus @default(PROSPECTIVE)
  politicalExperienceScore    Float?          // 0..100
  localConnectionScore        Float?
  mediaReadinessScore         Float?
  stakeholderStrengthScore    Float?
  localAssociationSupportScore Float?
  factionAcceptabilityScore   Float?
  issueCredibilityScore       Float?
  campaignCapacityScore       Float?
  riskScore                   Float?
  developmentPotentialScore   Float?
  overallReadinessScore       Float?
  summary                     String?
  strengths                   String[]
  weaknesses                  String[]
  developmentNeeds            String[]
  vettingStatus               VettingStatus   @default(NOT_STARTED)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@index([candidateStatus])
  @@index([personEntityId])
  @@index([currentTargetConstituencyId])
  @@index([partyEntityId])
}

model FactionProfile {
  id                  String              @id @default(uuid())
  entityId            String              @unique
  entity              Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  factionType         FactionType         @default(UNKNOWN)
  influenceScore      Float?              // 0..100
  leadershipAlignment LeadershipAlignment @default(UNKNOWN)
  currentMood         FactionMood         @default(UNKNOWN)
  riskLevel           InfluenceLevel      @default(UNKNOWN)
  confidence          Confidence          @default(LOW)
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([factionType])
}

model IssueProfile {
  id                    String        @id @default(uuid())
  entityId              String        @unique
  entity                Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name                  String
  issueCategory         IssueCategory @default(OTHER)
  nationalRelevance     Int?          // 1..5
  localRelevance        Int?          // 1..5
  mediaSensitivity      Int?          // 1..5
  factionSensitivity    Int?          // 1..5
  complianceSensitivity Int?          // 1..5
  description           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([issueCategory])
}

model PolicyProfile {
  id                    String       @id @default(uuid())
  entityId              String       @unique
  entity                Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  title                 String
  policyText            String?
  summary               String?
  issueEntityIds        String[]     // soft pointers -> Entity ids of ISSUEs
  policyStatus          PolicyStatus @default(DRAFT)
  announcementDate      DateTime?
  ownerEntityId         String?      // soft pointer -> Entity id
  overallPoliticalRisk  Severity     @default(LOW)
  overallComplianceRisk Severity     @default(LOW)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([policyStatus])
  @@index([ownerEntityId])
}

// =============================================================================
// RELATIONSHIP GRAPH
// =============================================================================

model Relationship {
  id                        String                @id @default(uuid())
  // graph edge endpoints — indexed UUID columns, resolved in service layer
  sourceEntityId            String
  targetEntityId            String
  type                      RelationshipType
  direction                 RelationshipDirection @default(DIRECTED)
  strength                  Int                   @default(3) // 1..5
  attitude                  Attitude              @default(UNKNOWN)
  influenceLevel            InfluenceLevel        @default(UNKNOWN)
  confidence                Confidence            @default(LOW)
  visibility                Visibility            @default(CLIENT_PRIVATE)
  relationshipOwnerUserId   String?
  relationshipOwnerEntityId String?
  lastInteractionAt         DateTime?
  validFrom                 DateTime?
  validTo                   DateTime?
  isCurrent                 Boolean               @default(true)
  summary                   String?
  privateNotes              String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  createdByUserId           String?
  updatedByUserId           String?

  evidenceLinks RelationshipEvidence[]

  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([type])
  @@index([isCurrent])
  @@index([lastInteractionAt])
  @@index([sourceEntityId, type])
  @@index([targetEntityId, type])
}

model RelationshipEvidence {
  id             String        @id @default(uuid())
  relationshipId String
  relationship   Relationship  @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  evidenceId     String
  evidence       EvidenceSource @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evidenceRole   EvidenceRole  @default(SUPPORTS)
  createdAt      DateTime      @default(now())

  @@unique([relationshipId, evidenceId])
  @@index([evidenceId])
}

// =============================================================================
// EVIDENCE / SOURCES
// =============================================================================

model EvidenceSource {
  id                 String             @id @default(uuid())
  title              String
  sourceType         SourceType         @default(MANUAL_ENTRY)
  url                String?
  fileId             String?
  rawText            String?
  summary            String?
  sourceDate         DateTime?
  observedAt         DateTime?
  addedByUserId      String?
  reliability        Reliability        @default(UNKNOWN)
  visibility         Visibility         @default(CLIENT_PRIVATE)
  dataClassification DataClassification @default(CLIENT_PRIVATE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  entityLinks       EntityEvidence[]
  relationshipLinks RelationshipEvidence[]

  @@index([sourceType])
  @@index([dataClassification])
  @@index([reliability])
}

model EntityEvidence {
  id           String         @id @default(uuid())
  entityId     String
  entity       Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  evidenceId   String
  evidence     EvidenceSource @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evidenceRole EvidenceRole   @default(SUPPORTS)
  createdAt    DateTime       @default(now())

  @@unique([entityId, evidenceId])
  @@index([evidenceId])
}

// =============================================================================
// EVENTS (temporal layer)
// =============================================================================

model PoliticalEvent {
  id                  String     @id @default(uuid())
  entityId            String     @unique // event's own base Entity (type EVENT)
  entity              Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  eventType           EventType  @default(OTHER)
  title               String
  summary             String?
  occurredAt          DateTime
  location            String?
  constituencyEntityId String?   // soft pointer
  issueEntityId        String?   // soft pointer
  sourceEvidenceId     String?   // soft pointer -> EvidenceSource
  confidence           Confidence @default(LOW)
  visibility           Visibility @default(CLIENT_PRIVATE)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  participants EventParticipant[]

  @@index([eventType])
  @@index([occurredAt])
  @@index([constituencyEntityId])
  @@index([issueEntityId])
}

model EventParticipant {
  id              String          @id @default(uuid())
  eventId         String
  event           PoliticalEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entityId        String
  entity          Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  participantRole ParticipantRole @default(ATTENDEE)
  createdAt       DateTime        @default(now())

  @@unique([eventId, entityId, participantRole])
  @@index([entityId])
}

// =============================================================================
// RISK
// =============================================================================

model Risk {
  id           String     @id @default(uuid())
  entityId     String     @unique // risk's own base Entity (type RISK)
  entity       Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  riskType     RiskType
  title        String
  description  String?
  severity     Severity   @default(MEDIUM)
  likelihood   Likelihood @default(UNKNOWN)
  urgency      Urgency    @default(MEDIUM)
  status       RiskStatus @default(OPEN)
  confidence   Confidence @default(LOW)
  ownerUserId  String?
  sourceModule String?
  rationale    String?
  mitigation   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  links RiskLink[]

  @@index([riskType])
  @@index([status])
  @@index([severity])
  @@index([sourceModule])
}

model RiskLink {
  id        String       @id @default(uuid())
  riskId    String
  risk      Risk         @relation(fields: [riskId], references: [id], onDelete: Cascade)
  entityId  String
  entity    Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  role      RiskLinkRole @default(AFFECTED)
  createdAt DateTime     @default(now())

  @@unique([riskId, entityId, role])
  @@index([entityId])
}

// =============================================================================
// SCORE (generic, shared scoring infrastructure)
// =============================================================================

model Score {
  id              String     @id @default(uuid())
  subjectEntityId String     // indexed UUID column
  contextEntityId String?    // e.g. the constituency a candidate score is "for"
  scoreType       ScoreType
  value           Float
  scaleMin        Float      @default(0)
  scaleMax        Float      @default(100)
  confidence      Confidence @default(LOW)
  sourceModule    String?
  modelVersion    String?
  rationale       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([subjectEntityId])
  @@index([contextEntityId])
  @@index([scoreType])
  @@index([subjectEntityId, scoreType])
  @@index([subjectEntityId, contextEntityId, scoreType])
}

// =============================================================================
// MARKET / MACRO SIGNAL LAYER
// -----------------------------------------------------------------------------
// Markets are NOT entities (no identity, no agency, cannot be an end of a
// Relationship). They are exogenous signal. Each row is one observation of one
// series at one time, stored bitemporally so training samples can ask "what did
// the market look like as known at date T" without leakage — mirroring the
// point-in-time discipline used elsewhere in Arrow's feature store.
//
// `seriesCode` is deliberately free-text (e.g. "UK_GILT_10Y", "FTSE_100",
// "GBPUSD"), not an enum: adding a new instrument must not require a migration.
// `seriesType` gives typed grouping; `jurisdiction` carries transferability.
//
// A market move that is politically meaningful (e.g. the 2022 gilt spike) is
// recorded as a PoliticalEvent of type MARKET_REACTION and linked to the
// triggering policy/actor via its soft pointers + EventParticipant. The numeric
// series lives here and is joined to that event by (seriesCode, time) in the
// service layer — consistent with the relational-as-graph design (decision #2).
// =============================================================================

model MarketSignal {
  id               String           @id @default(uuid())
  seriesCode       String           // stable instrument code, e.g. "UK_GILT_10Y"
  seriesType       MarketSignalType @default(OTHER)
  jurisdiction     String?          @default("UK") // ISO country / polity code
  value            Float
  unit             String?          // e.g. "percent", "bps", "index", "rate"
  observedAt       DateTime         // event time — when the market printed this
  ingestedAt       DateTime         @default(now()) // observability time — when we recorded it
  source           SourceType       @default(MARKET_DATA)
  sourceEvidenceId String?          // soft pointer -> EvidenceSource
  metadata         Json?

  @@unique([seriesCode, observedAt])
  @@index([seriesCode])
  @@index([seriesType])
  @@index([observedAt])
  @@index([seriesCode, observedAt])
  @@index([jurisdiction])
}

// =============================================================================
// CANDIDATE-SEAT ASSESSMENT (bridge between candidate selection and FPTP)
// =============================================================================

model CandidateSeatAssessment {
  id                          String   @id @default(uuid())
  candidateEntityId           String
  constituencyEntityId        String
  assessmentDate              DateTime @default(now())
  overallFitScore             Float?
  readinessScore              Float?
  localConnectionScore        Float?
  stakeholderCoverageScore    Float?
  localAssociationSupportScore Float?
  factionAcceptabilityScore   Float?
  mediaReadinessScore         Float?
  issueCredibilityScore       Float?
  riskScore                   Float?
  developmentPotentialScore   Float?
  summary                     String?
  topStrengths                String[]
  topWeaknesses               String[]
  recommendedActions          String[]
  evidenceSummary             String?
  confidence                  Confidence @default(LOW)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([candidateEntityId])
  @@index([constituencyEntityId])
  @@index([candidateEntityId, constituencyEntityId])
}

// =============================================================================
// FPTP DATA STRUCTURES (consumed/written by the FPTP module — not computed here)
// =============================================================================

model ElectionResult {
  id                   String   @id @default(uuid())
  constituencyEntityId String
  electionDate         DateTime
  partyEntityId        String?
  candidateEntityId    String?
  votes                Int
  voteShare            Float    // 0..100
  position             Int
  turnout              Float?   // 0..100
  sourceEvidenceId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([constituencyEntityId])
  @@index([electionDate])
  @@index([constituencyEntityId, electionDate])
}

model FPTPScenario {
  id                       String                  @id @default(uuid())
  constituencyEntityId     String
  candidateEntityId        String?
  scenarioType             FPTPScenarioType
  title                    String
  assumptions              Json?
  estimatedWinProbability  Float?                  // 0..1
  estimatedVoteShareLow    Float?                  // 0..100
  estimatedVoteShareMid    Float?
  estimatedVoteShareHigh   Float?
  strategicValueScore      Float?                  // 0..100
  resourceWasteRisk        Float?                  // 0..100
  spoilerRisk              Float?
  tacticalVotingRisk       Float?
  localPartyImpact         String?
  stakeholderImpact        String?
  candidateDevelopmentValue Float?
  futureElectionValue      Float?
  recommendationLabel      FPTPRecommendationLabel?
  rationale                String?
  confidence               Confidence              @default(LOW)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([constituencyEntityId])
  @@index([candidateEntityId])
  @@index([scenarioType])
}

// =============================================================================
// POLICY RADIUS
// =============================================================================

model PolicyImpact {
  id                  String          @id @default(uuid())
  policyEntityId      String
  affectedEntityId    String
  impactType          PolicyImpactType
  impactDirection     ImpactDirection @default(UNKNOWN)
  severity            Severity        @default(MEDIUM)
  confidence          Confidence      @default(LOW)
  rationale           String?
  recommendedActionId String?         // soft pointer -> ActionRecommendation
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([policyEntityId])
  @@index([affectedEntityId])
  @@index([impactType])
}

// =============================================================================
// ACTION RECOMMENDATION
// =============================================================================

model ActionRecommendation {
  id                    String              @id @default(uuid())
  title                 String
  description           String?
  actionType            ActionType
  priority              ActionPriority      @default(MEDIUM)
  status                ActionStatus        @default(RECOMMENDED)
  targetEntityId        String?
  ownerUserId           String?
  ownerEntityId         String?
  dueDate               DateTime?
  sourceModule          String?
  rationale             String?
  expectedBenefit       String?
  downsideIfIgnored     String?
  approvalRequirement   ApprovalRequirement @default(NONE)
  relatedRiskId         String?
  relatedScenarioId     String?
  relatedPolicyImpactId String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  completedAt           DateTime?

  @@index([status])
  @@index([priority])
  @@index([targetEntityId])
  @@index([sourceModule])
  @@index([dueDate])
}

// =============================================================================
// COMPLIANCE + AUDIT
// =============================================================================

model ComplianceFlag {
  id              String               @id @default(uuid())
  entityId        String
  entity          Entity               @relation(fields: [entityId], references: [id], onDelete: Cascade)
  flagType        ComplianceFlagType
  severity        Severity             @default(MEDIUM)
  description     String?
  status          ComplianceFlagStatus @default(OPEN)
  reviewOwnerUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([entityId])
  @@index([flagType])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityId    String?
  objectType  String
  objectId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  @@index([entityId])
  @@index([objectType, objectId])
  @@index([actorUserId])
  @@index([createdAt])
}
